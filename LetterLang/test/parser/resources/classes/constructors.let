class Pair1 {
  let first, second;

  constructor(first, second) {
    this.first = first;
    this.second = second;
  }

  def sum() {
    return first + second;
  }
}

class Pair2(first, second) {
  def sum() {
    return first + second;
  }
}

class Pair3(first, second)

class Pair4 extends Pair1 {
  constructor(first, second) {
    super(first, second);
  }
}
